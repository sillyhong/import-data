  },
  "scripts": {
    "fetchImport": "cross-env TASK_ENV=local node importgenius/cli.js fetch-importers",
    "fetchShipments": "cross-env TASK_ENV=local node importgenius/cli.js fetch-shipments",
    "importgenius:sync:dev": "cross-env TASK_ENV=local ENV=dev node importgenius/cli.js sync",
    "importyeti": "cross-env TASK_ENV=local node importyeti/cli.js",
    "importyeti:production": "cross-env TASK_ENV=production node importyeti/cli.js",
